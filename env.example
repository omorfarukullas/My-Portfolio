# ==============================================================================
# Environment Configuration for Portfolio & Blog CMS
# Copy this file to .env.local and add your real keys
# ==============================================================================

# 1. Admin Master Passcode for Blog Management
ADMIN_PASSWORD=your_secure_master_password_here

# 2. JWT Encryption Key for Admin Session Token (any random 32+ character string)
ADMIN_JWT_SECRET=super_secret_jwt_random_key_32_characters_long!

# 3. Supabase Project Configuration (https://supabase.com)
# Kept completely private on the server side (no NEXT_PUBLIC_ prefix needed)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
